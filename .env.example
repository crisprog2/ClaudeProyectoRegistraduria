# Copiar a .env (en la raíz del repositorio) y completar. Nunca subir .env al repositorio.
# El módulo de settings no se define aquí: manage.py usa config.settings.local
# y backend/pytest.ini usa config.settings.test.

# --- Django ---
# Obligatoria. Cadena larga y aleatoria.
DJANGO_SECRET_KEY=
# true / false. En local, por defecto true.
DJANGO_DEBUG=
# Hosts separados por coma. En local, por defecto localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=
# Orígenes del frontend separados por coma, con esquema y puerto.
CORS_ALLOWED_ORIGINS=
# Consultas por minuto por IP. Por defecto 30. Para correr la suite black-box
# (tests/api) levanta el servidor con un valor alto, p. ej. 1000.
CONSULTA_LIMITE_POR_MINUTO=

# --- MySQL (servidor local 8.0) ---
# Obligatorias. Usuario propio del proyecto, no root.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Por defecto 127.0.0.1 y 3306.
MYSQL_HOST=
MYSQL_PORT=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=

# --- Pruebas ---
API_BASE_URL=
FRONTEND_BASE_URL=
BROWSER=
HEADLESS=
