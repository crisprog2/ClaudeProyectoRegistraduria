# Copiar a .env (en la raíz del repositorio) y completar. Nunca subir .env al repositorio.
# El módulo de settings no se define aquí: manage.py usa config.settings.local
# y backend/pytest.ini usa config.settings.test.

# --- Django ---
# Obligatoria. Cadena larga y aleatoria.
DJANGO_SECRET_KEY=
# true / false. En local, por defecto true (también si queda vacía).
DJANGO_DEBUG=
# Hosts separados por coma. En local, por defecto localhost,127.0.0.1.
DJANGO_ALLOWED_HOSTS=
# Orígenes del frontend separados por coma, con esquema y puerto.
CORS_ALLOWED_ORIGINS=
# Consultas por minuto por IP. Por defecto 30. Para correr las pruebas black-box
# (API, BDD y E2E) levanta el servidor con un valor alto, p. ej. 1000.
CONSULTA_LIMITE_POR_MINUTO=
# Intentos de inicio de sesión por minuto por IP (contra fuerza bruta). Por defecto 5.
# scripts/pruebas.py levanta el servidor de pruebas con 1000.
INGRESO_LIMITE_POR_MINUTO=

# --- Sesión (JWT) ---
# true solo en un despliegue con HTTPS: la cookie del token de refresco viaja solo por HTTPS.
# En local se trabaja con http://, así que va en false (o vacía). Ver docs/decisiones/0002.
JWT_COOKIE_SECURE=

# --- Usuarios de demostración ---
# Contraseñas de admin.demo (Administrador) y analista.demo (Analista). Las usa
# "python manage.py crear_usuarios_demo" (y scripts/pruebas.py base), y las pruebas
# black-box para iniciar sesión. Inventa las tuyas: mínimo 8 caracteres, que no sean
# comunes, ni solo números, ni parecidas al usuario.
DEMO_ADMIN_CONTRASENA=
DEMO_ANALISTA_CONTRASENA=

# --- MySQL (servidor local 8.0) ---
# Obligatorias. Usuario propio del proyecto, no root.
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# Por defecto 127.0.0.1 y 3306.
MYSQL_HOST=
MYSQL_PORT=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=

# --- Pruebas ---
# Por defecto http://127.0.0.1:8000 y http://localhost:5173.
# El navegador se elige con las opciones de pytest-playwright (--browser, --headed).
API_BASE_URL=
FRONTEND_BASE_URL=
